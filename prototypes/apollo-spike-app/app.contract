// PROTOTYPE. Apollo on Exact: pair with an Apollo connector, work Apollo's inbox (threads and cloud
// cards, settle), open a card and answer it, start a thread, and follow a run live with Stop and
// approvals. app.ts holds the data and the connection.

use setAppShortcuts, ShortcutItem, AppleShortcutItem from "@exact/quick-actions"
use getUserMedia, stopTrack, MediaStream, MediaStreamTrack from "@exact/media-capture"
use audioLevel, AudioLevel from "@exact/recording"
use startSpeechRecognition, stopSpeechRecognition, abortSpeechRecognition, speechRecognitionState, speechRecognitionAvailability, installSpeechRecognition, SpeechRecognitionInfo, SpeechRecognitionState, SpeechRecognitionAvailability, SpeechRecognitionInstall from "@exact/speech-recognition"

routes nav
  home "/"
    session "/s/:id"
    compose "/new"
    settings "/settings"
    share "/share"
    card "/c/:id"

shape Account
  paired: bool
  label: string
  endpoint: string

shape CardButton
  id: string
  label: string
  style: string
  input: bool
  url: string

shape Pick
  n: number
  text: string
  sub: string
  url: string
  done: bool

shape Pair
  key: string
  value: string

shape Item
  key: string
  kind: string
  id: string
  title: string
  subtitle: string
  badge: string
  tone: string
  time: string
  settled: bool
  swipe: string
  count: number
  glyph: string
  link: string
  actions: CardButton[]
  picks: Pick[]
  meta: Pair[]
  summary: string
  snooze: bool

shape SnoozeOption
  id: string
  label: string
  when: string
  until: number

shape Inbox
  error: string
  items: Item[]
  snoozeOptions: SnoozeOption[]

shape Metric
  label: string
  value: string
  delta: string
  tone: string

shape CardView
  found: bool
  id: string
  kind: string
  source: string
  title: string
  body: string
  plainText: bool
  outcome: string
  url: string
  threadId: string
  open: bool
  settled: bool
  swipe: string
  meta: Pair[]
  metrics: Metric[]
  picks: Pick[]
  actions: CardButton[]
  progress: string
  progressValue: number
  error: string

shape Step
  key: string
  kind: string
  label: string
  detail: string
  running: bool
  failed: bool

shape Cell
  key: string
  text: string
  align: string
  first: bool

shape TableRow
  key: string
  head: bool
  cells: Cell[]

shape Row
  id: string
  kind: string
  text: string
  table: TableRow[]
  status: string
  summary: string
  running: bool
  startedAt: number
  steps: Step[]

shape Recent
  id: string
  title: string

shape ModelOption
  key: string
  id: string
  provider: string
  label: string
  isDefault: bool

shape Skill
  name: string
  description: string

shape Toolset
  name: string
  label: string
  enabled: bool
  tools: number

shape Options
  models: ModelOption[]
  skills: Skill[]
  toolsets: Toolset[]
  defaultModel: string
  platform: string
  error: string

// A picked file waiting to go with the next message.
shape Draft
  name: string
  type: string
  size: number
  path: string

shape Thread
  title: string
  rows: Row[]
  runId: string
  status: string
  active: bool
  ended: bool
  error: string
  approvalId: string
  approvalTitle: string
  approvalCommand: string
  approvalReason: string
  settled: bool
  canSettle: bool
  autoSettle: bool
  activityAt: number
  recent: Recent[]
  model: string

shape Created
  id: string
  error: string

shape Ack
  error: string

shape Page
  visibilityState: string
  onLine: bool
  canShare: bool
  canShareFiles: bool

shape Time
  epochAtZero: number
  utcOffset: number

fn secs(t: number): number = t > 100000000000 ? t / 1000 : t
fn took(s: number): string = s < 60 ? `${floor(s)}s` : s < 3600 ? `${floor(s / 60)}m ${floor(s - floor(s / 60) * 60)}s` : `${floor(s / 3600)}h ${floor((s - floor(s / 3600) * 3600) / 60)}m`
fn toneColor(t: string): string = t == "amber" ? "-exact-system-orange" : t == "accent" ? "AccentColor" : t == "green" ? "-exact-system-green" : t == "red" ? "-exact-system-red" : "-exact-secondary-label"

component Apollo
  state draft = ""
  state link = ""
  state reply = ""
  state replying = ""
  state revision = 0
  state accountRevision = 0
  state tick = 0
  state clock = 0
  state notice = ""
  state opened = []
  state showSettled = false
  state showSnoozed = false
  state searchText = ""
  state query = ""
  state aimedSnooze = false
  state composeModel = ""
  state files: Draft[] = []
  state recognitionId = ""
  state dictating = false
  // The voice bar is up from the mic tap until the words land (or are thrown away).
  state voicing = false
  state voiceCancelled = false
  state dictationBase = ""
  state trackId = ""
  state aimed = ""
  state aimedSwipe = ""
  state aimedKind = ""
  state chasing = false
  state wasHidden = false
  derive selected = match stack(nav).filter(e => e.name == "session").at(-1) { case some(e) => e.params.id, case none => "" }
  derive selectedCard = match stack(nav).filter(e => e.name == "card").at(-1) { case some(e) => e.params.id, case none => "" }
  derive now = time.epochAtZero + tick
  resource page = exactPage() as shape Page
  resource time = exactTime() as shape Time
  resource account = account(accountRevision) as shape Account
  resource inbox = inbox(revision, account.paired, showSettled, showSnoozed, query) with now as shape Inbox
  resource thread = transcript(selected, revision) with now as shape Thread
  resource card = card(selectedCard, revision) as shape CardView
  resource options = agentOptions(account.paired, accountRevision) as shape Options
  resource voice = speechRecognitionAvailability(langs=["en-US"], processLocally=true) as shape SpeechRecognitionAvailability else empty()
  resource heard = speechRecognitionState(recognition=recognitionId, interval=100) as shape SpeechRecognitionState else empty()
  mutation micOpened as shape MediaStream then micReady
  mutation voiceInstalled as shape SpeechRecognitionInstall then afterVoiceInstall
  mutation micClosed as shape MediaStreamTrack
  mutation listening as shape SpeechRecognitionInfo then dictationStarted
  mutation stoppedListening as shape SpeechRecognitionInfo
  mutation abortedListening as shape SpeechRecognitionInfo
  // Only for the bar's clock: the waveform view meters the track itself.
  resource level = audioLevel(track=trackId, interval=250, history=1) as shape AudioLevel else empty()
  mutation removed as shape Ack then afterDelete
  mutation paired as shape Ack then afterPair
  mutation unpaired as shape Ack then afterPair
  mutation created as shape Created then afterCreate
  mutation sent as shape Ack then afterSend
  mutation stopped as shape Ack
  mutation answered as shape Ack
  mutation filed as shape Ack then afterWrite
  mutation responded as shape Ack then afterWrite
  derive onHome = top(nav).name == "home"
  derive canSend = (draft.trim() != "" or files.length > 0) and not dictating and not thread.active and not pending(sent) and not pending(created)
  derive lastId = match thread.rows.at(-1) { case some(r) => r.id, case none => "" }
  // Quick actions: the manifest's New thread, then the threads opened last (as Apollo does).
  derive recentKey = thread.recent.map(r => `${r.id}|${r.title}`).join("\n")
  derive currentModel = top(nav).name == "compose" ? composeModel : thread.model
  derive modelLabel = match options.models.filter(m => m.key == currentModel).at(0) { case some(m) => m.label, case none => "Default model" }
  derive heardNow = recognitionId != "" and heard.id == recognitionId
  derive spoken = not heardNow ? "" : heard.results.map(r => r.alternatives.slice(0, 1).map(a => a.transcript).join("")).join(" ")
  derive interim = not heardNow ? "" : match heard.interim { case some(i) => i.alternatives.slice(0, 1).map(a => a.transcript).join(""), case none => "" }
  derive hearing = dictating and heardNow and heard.audio
  derive micSilent = dictating and level.totalSamplesDuration == 0 and spoken == "" and interim == ""
  derive voiceSeconds = floor(level.totalSamplesDuration)
  derive voiceClock = `${floor(voiceSeconds / 60)}:${voiceSeconds % 60 < 10 ? "0" : ""}${voiceSeconds % 60}`
  derive voiceBar = voicing and dictationError == ""
  derive dictated = [dictationBase.trim(), spoken.trim(), interim.trim()].filter(t => t != "").join(" ")
  derive dictationError = match failure(micOpened) { case some(e) => `Microphone: ${e.message}`, case none => match failure(listening) { case some(e) => `Dictation: ${e.message}`, case none => match failure(voiceInstalled) { case some(e) => `Speech model: ${e.message}`, case none => "" } } }
  derive shareText = [searchParam(top(nav), "title"), searchParam(top(nav), "text"), searchParam(top(nav), "url")].filter(t => t != "").join(" · ")
  derive shareIncoming = sharedFiles(top(nav), "files")
  derive shareThreads = inbox.items.filter(i => i.kind == "session" and not i.settled).slice(0, 8)
  derive shownError = notice != "" ? notice : dictationError != "" ? dictationError : onHome ? inbox.error : top(nav).name == "card" ? card.error : thread.error

  // A finished run hands back to durable history, as Apollo reloads messages after a terminal event.
  task settle when thread.ended and thread.runId != ""
    after(300, refreshAll)
  // The inbox stays fresh while it is on screen.
  task poll when account.paired and onHome and page.visibilityState == "visible"
    every(15000, refreshAll)
  // A running turn's elapsed time.
  task ticker when thread.active
    every(1000, tickClock)
  // A return from the background reconnects: the stream does not survive suspension.
  task hid when page.visibilityState == "hidden"
    after(1, markHidden)
  task returned when wasHidden and page.visibilityState == "visible"
    after(1, onReturn)
  task chase when chasing
    after(350, toEnd)
  // Search filters as you type, a beat after the last key, so each key doesn't refetch the inbox.
  task searching when searchText != query key=searchText
    after(250, applySearch)
  // Dictation ends on its own after a pause too; either way its words land in the draft.
  // `heard` keeps the last recognition's state until the new one's first reply: match the id, or a
  // second dictation reads the first one's "ended" and closes at once.
  task heardOut when dictating and heardNow and heard.state == "ended"
    after(1, finishDictation)
  // A microphone that never delivers a sample would leave the bar spinning: say so instead.
  task voiceStall when micSilent
    after(6000, voiceStalled)
  task shortcuts when recentKey != "" key=recentKey
    after(1, publishShortcuts)

  action publishShortcuts
    setAppShortcuts(shortcuts=thread.recent.map(r => ShortcutItem(name=r.title, short_name=none, description=none, url=`/s/${r.id}`,
      icons=none, apple=some(AppleShortcutItem(symbol=some("bubble.left"))), android=none)))
  action refreshAll
    tick = performanceNow()
    revision = revision + 1
  action tickClock
    clock = time.epochAtZero + performanceNow()
  action markHidden
    wasHidden = true
  action onReturn
    wasHidden = false
    refreshAll()
  action toEnd
    chasing = false
    scrollIntoView("transcript", lastId, block="end")

  // On a wide window a thread or card shows beside the inbox, and the next one opened replaces it.
  action follow(url: string)
    nav = (top(nav).name == "session" or top(nav).name == "card") and (url.startsWith("/s/") or url.startsWith("/c/")) ? replace(nav, url) : go(nav, url)
    draft = ""
    notice = ""
    replying = ""
    tick = performanceNow()
    clock = time.epochAtZero + performanceNow()
  action back
    nav = back(nav)
    refreshAll()
  action openNew
    draft = ""
    notice = ""
    nav = top(nav).name == "compose" ? nav : push(nav, "/new")
  action openLink(url: string)
    openURL(url)
  // A pick's text opens its link, or the card when it has none. Only the ring checks it off.
  action openPick(id: string, p: Pick)
    if p.url != ""
      openURL(p.url)
    else if top(nav).name != "card"
      nav = go(nav, path("card", id))
  action toggleSection(id: string)
    if id == "snoozed"
      showSnoozed = not showSnoozed
    else
      showSettled = not showSettled
  action search(v: string)
    searchText = v
  action applySearch
    query = searchText
  // Snooze is this phone's alone, as in Apollo; until 0 wakes the thread.
  action snoozeAimed(until: number)
    send filed = snooze(aimed, until)

  action editLink(v: string)
    link = v
  action pair
    if link.trim() != "" and not pending(paired)
      send paired = pair(link.trim())
  action askUnpair
    showModal("unpair")
  action unpair
    nav = top(nav).name == "settings" ? back(nav) : nav
    send unpaired = unpair()
  action afterPair
    match paired
      case some(p)
        notice = p.error
        if p.error == ""
          link = ""
      case none
        notice = ""
    accountRevision = accountRevision + 1
    refreshAll()

  // Settle and reopen: threads on the connector (every phone sees it), cards on this phone.
  action aim(id: string, kind: string, swipe: string, canSnooze: bool)
    aimed = id
    aimedKind = kind
    aimedSwipe = swipe
    aimedSnooze = canSnooze
  // UIKit's swipe action presses the button but not its popovertarget, so open the menu here.
  action swipeSnooze(id: string, kind: string, swipe: string)
    aimed = id
    aimedKind = kind
    aimedSwipe = swipe
    aimedSnooze = true
    showPopover("snooze-menu")
  action settleAimed
    if aimedSwipe == "unsnooze"
      send filed = snooze(aimed, 0)
    else if aimedKind == "session"
      send filed = settleThread(aimed, aimedSwipe == "settle", time.epochAtZero + performanceNow())
    else
      send filed = settleCard(aimed, aimedSwipe == "settle")
  action settleRow(id: string, kind: string, swipe: string)
    if swipe == "unsnooze"
      send filed = snooze(id, 0)
    else if kind == "session"
      send filed = settleThread(id, swipe == "settle", time.epochAtZero + performanceNow())
    else
      send filed = settleCard(id, swipe == "settle")
  action settleThread(settle: bool)
    send filed = settleThread(selected, settle, time.epochAtZero + performanceNow())
  action toggleAutoSettle
    send filed = setAutoSettle(selected, not thread.autoSettle)
  action settleOpenCard(settle: bool)
    send filed = settleCard(card.id, settle)
  action afterWrite
    let a = match filed { case some(f) => f.error, case none => "" }
    let b = match responded { case some(r) => r.error, case none => "" }
    notice = a != "" ? a : b
    replying = ""
    reply = ""
    refreshAll()

  action answerCard(id: string, action: CardButton)
    if action.input
      nav = go(nav, path("card", id))
      replying = action.id
      reply = ""
    else if action.url != ""
      openURL(action.url)
    else
      send responded = respondCard(id, action.id, "")
  action startReply(action: CardButton)
    replying = action.id
    reply = ""
  action cardAction(action: CardButton)
    if action.input
      startReply(action)
    else
      answerCard(card.id, action)
  action editReply(v: string)
    reply = v
  action sendReply
    if reply.trim() != ""
      send responded = respondCard(card.id, replying, reply.trim())
  action cancelReply
    replying = ""
  action toggle(p: Pick)
    if card.open
      send responded = togglePick(card.id, p.n, not p.done)
  action pickRow(id: string, p: Pick)
    send responded = togglePick(id, p.n, not p.done)

  action edit(v: string)
    draft = v
  action composerKey(k: string, e: KeyboardEvent)
    if k == "Enter" and (e.metaKey or e.ctrlKey)
      preventDefault()
      submit()
  action submit
    if canSend
      if top(nav).name == "compose"
        send created = createThread(draft.trim(), composeModel, files)
      else
        send sent = startRun(selected, draft.trim(), files)
      draft = ""
      files = []
  // Model: a new thread keeps it for its first run; an open thread asks Hermes to switch.
  action pickModel(key: string)
    if top(nav).name == "compose"
      composeModel = key
    else
      send filed = setModel(selected, key)
  // Skills: a $name in the message, as Apollo's composer writes them.
  action insertSkill(name: string)
    draft = `${draft == "" or draft.endsWith(" ") ? draft : draft + " "}$${name} `
  action attach(id: string)
    showPicker(id)
  action picked(fs: Picked[])
    files = files.concat(fs.map(f => Draft(name=f.name, type=f.type, size=f.size, path=f.path))).slice(0, 10)
  action unattach(path: string)
    files = files.filter(f => f.path != path)
  // Voice: on-device recognition, as Apollo's; the words join the draft when it stops.
  // Voice, as T3 Code does it: the mic swaps the composer for a bar (cancel, waveform and time,
  // done); the words join the draft when it's done.
  action dictate
    voicing = true
    voiceCancelled = false
    notice = ""
    dictationBase = draft
    // iOS 26 transcribes on the device only once its English model is installed.
    if voice.availability == "available"
      send micOpened = getUserMedia(audio=true)
    else
      send voiceInstalled = installSpeechRecognition(langs=["en-US"], processLocally=true)
  action voiceStalled
    if micSilent
      voiceCancelled = true
      notice = "The microphone didn't start. Try again."
      send abortedListening = abortSpeechRecognition(recognition=recognitionId)
  action finishVoice
    send stoppedListening = stopSpeechRecognition(recognition=recognitionId)
  action cancelVoice
    voiceCancelled = true
    if dictating
      send abortedListening = abortSpeechRecognition(recognition=recognitionId)
    else
      voicing = false
      closeMic()
  action closeMic
    if trackId != ""
      send micClosed = stopTrack(track=trackId)
    trackId = ""
  action afterVoiceInstall
    match voiceInstalled
      case some(i)
        if not voicing
          notice = ""
        else if i.installed
          send micOpened = getUserMedia(audio=true)
        else
          voicing = false
          notice = "Dictation: this iPhone could not install the English speech model"
      case none
        voicing = false
  action micReady
    match micOpened
      case some(m)
        let id = match m.tracks.at(0) { case some(t) => t.id, case none => "" }
        trackId = id
        if voicing
          send listening = startSpeechRecognition(track=id, lang="en-US", continuous=true, interimResults=true, processLocally=true)
        else if id != ""
          send micClosed = stopTrack(track=id)
      case none
        voicing = false
        trackId = ""
  action dictationStarted
    match listening
      case some(r)
        match r.error
          case some(e)
            voicing = false
            notice = `Dictation stopped: ${e}`
            closeMic()
          case none
            recognitionId = r.id
            dictating = true
            if not voicing
              send abortedListening = abortSpeechRecognition(recognition=r.id)
      case none
        voicing = false
        closeMic()
  action finishDictation
    notice = voiceCancelled ? notice : match heard.error { case some(e) => `Dictation stopped: ${match heard.message { case some(m) => m, case none => e }}`, case none => "" }
    draft = voiceCancelled ? dictationBase : dictated
    dictating = false
    voicing = false
    recognitionId = ""
    closeMic()
  action askDelete(id: string)
    aimed = id
    showModal("delete-thread")
  action deleteAimed
    send removed = deleteThread(aimed)
  action afterDelete
    match removed
      case some(r)
        notice = r.error
        if r.error == "" and top(nav).name == "session" and selected == aimed
          nav = back(nav)
      case none
        notice = ""
    refreshAll()
  // Share to Apollo: what another app shared becomes the draft of a new or open thread, as in
  // Apollo; nothing is sent until the person sends it.
  action useShare(e: Entry, target: string)
    draft = [searchParam(e, "title"), searchParam(e, "text"), searchParam(e, "url")].filter(t => t != "").join("\n\n")
    files = sharedFiles(e, "files").files.map(f => Draft(name=f.name, type=f.type, size=f.size, path=f.path)).slice(0, 10)
    nav = replace(nav, target == "" ? "/new" : path("session", target))
  action openSettings
    nav = push(nav, "/settings")
  action afterCreate
    match created
      case some(c)
        notice = c.error
        if c.id != ""
          nav = replace(nav, path("session", c.id))
          chasing = true
      case none
        notice = ""
  action afterSend
    match sent
      case some(s)
        notice = s.error
      case none
        notice = ""
    refreshAll()
    chasing = true
  action stop
    if thread.runId != ""
      send stopped = stopRun(thread.runId)
  action approve
    send answered = answerApproval(thread.runId, thread.approvalId, "once")
  action deny
    send answered = answerApproval(thread.runId, thread.approvalId, "deny")
  action toggleSteps(id: string)
    opened = opened.includes(id) ? opened.filter(x => x != id) : opened.concat([id])

  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow testId="app" width="100%" height="100%"
      for e in stack(nav) key=e.id
        if e.name == "home"
          // iPad and other wide windows: the inbox beside the open thread, as Apollo's split view.
          column navigationKey=`${e.id}` navigationScroll="inbox" navigationSplit="340" position="absolute" inset=0 display="flex" flex-direction="column"
            header display="flex" flex-wrap="wrap" align-items="center" gap=8 padding="8px 16px"
              text "Inbox" role="heading" aria-level=1 flex=1
              if account.paired
                button popovertarget="home-menu" aria-label="More" testId="more"
                  image "symbol:more"
                button press=openNew aria-label="New Thread" aria-keyshortcuts="Meta+N" testId="new"
                  image "symbol:compose"
              if account.paired
                input type="search" value=searchText input=search placeholder="Search" aria-label="Search threads" testId="search" width="100%"
            column id="home-menu" popover="auto" role="menu" aria-label=account.label
              button press=openSettings popovertarget="home-menu" popovertargetaction="hide" testId="settings"
                text "Settings"
              button press=askUnpair destructive=true popovertarget="home-menu" popovertargetaction="hide" testId="unpair"
                text "Unpair"
            if account.paired
              if shownError != ""
                text shownError font="-exact-footnote" color="-exact-system-red" padding="4px 16px" testId="error"
              list id="inbox" appearance="auto" listStyle="plain" flex=1 min-height=0 testId="inbox"
                section
                  for it in inbox.items key=it.key
                    if it.kind == "section"
                      button appearance="none" press=toggleSection(it.id) display="flex" flex-direction="row" align-items="center" justify-content="flex-start" gap=6 padding="14px 16px 6px" testId=`section-${it.id}`
                        image ((it.id == "snoozed" ? showSnoozed : showSettled) or query != "" ? "symbol:sf/chevron.down" : "symbol:forward-chevron") font-size=12 color="-exact-secondary-label"
                        text `${it.title} · ${it.count}` font="-exact-subheadline" color="-exact-secondary-label"
                    else if it.kind == "caughtUp"
                      row justify-content="center" padding="24px 0"
                        text it.title color="-exact-secondary-label" testId="caught-up"
                    else
                      // Swipe left to settle or reopen, as Apollo's rows do; long press for the same in a menu.
                      scroll swipeContent="content" swipeTrailing="swipe" swipeLeading="snooze" display="flex" padding-right=0 overflow-x="scroll" overflow-y="hidden"
                        scrollbar-width="none" scroll-snap-type="x mandatory"
                        column id="content" width="100%" flex-shrink=0 scroll-snap-align="start" box-sizing="border-box" gap=8 padding="8px 16px"
                          link href=(it.kind == "session" ? path("session", it.id) : path("card", it.id)) contextmenu=aim(it.id, it.kind, it.swipe, it.snooze) contextPopover="row-menu" testId=`row-${it.id}`
                            row gap=10 align-items="flex-start" flex=1 min-width=0
                              if it.glyph != ""
                                text it.glyph font="-exact-footnote" font-weight=600 color="AccentColor" width=24 height=24 border-radius=12
                                  background-color="-exact-secondary-background" text-align="center" line-height="24px" flex-shrink=0
                              column flex=1 min-width=0 gap=2
                                row gap=8 align-items="baseline"
                                  text it.title font=(it.settled ? "-exact-body" : "-exact-headline") color=(it.settled ? "-exact-secondary-label" : "-exact-label") line-clamp=(it.settled ? 1 : 2) flex=1 min-width=0
                                  if it.badge != ""
                                    text it.badge font="-exact-footnote" color=toneColor(it.tone) flex-shrink=0
                                  else
                                    text it.time font="-exact-footnote" color="-exact-secondary-label" flex-shrink=0
                                if it.subtitle != ""
                                  text it.subtitle font="-exact-subheadline" color="-exact-secondary-label" line-clamp=2
                          if it.picks.length > 0
                            column padding-left=34 gap=2
                              for p in it.picks key=p.n
                                PickRow(pick=p, press=pickRow(it.id, p), open=openPick(it.id, p), off=pending(responded), tid=`row-pick-${it.id}-${p.n}`)
                          for m in it.meta key=m.key
                            text `${m.key} ${m.value}` font="-exact-subheadline" color="-exact-secondary-label" line-clamp=2 padding-left=34
                          if it.summary != ""
                            text it.summary font="-exact-subheadline" color="-exact-secondary-label" padding-left=34 testId=`summary-${it.id}`
                          else if it.actions.length > 0
                            row gap=8 padding-left=(it.glyph != "" ? 34 : 0) flex-wrap="wrap"
                              for a in it.actions key=a.id
                                button press=answerCard(it.id, a) buttonStyle=(a.style == "primary" ? "filled" : "bordered") destructive=(a.style == "destructive") disabled=pending(responded) testId=`act-${it.id}-${a.id}`
                                  text a.label
                        // Swipe right to snooze, as in Apollo: the press picks a time from the menu.
                        if it.snooze
                          button id="snooze" press=swipeSnooze(it.id, it.kind, it.swipe) accent-color="-exact-system-purple" flex-shrink=0 scroll-snap-align="start" testId=`snooze-${it.id}`
                            text "Snooze"
                        if it.swipe != ""
                          button id="swipe" press=settleRow(it.id, it.kind, it.swipe) accent-color=(it.swipe == "settle" ? "AccentColor" : "-exact-system-indigo") flex-shrink=0 scroll-snap-align="start" testId=`swipe-${it.id}`
                            text (it.swipe == "settle" ? "Settle" : it.swipe == "unsnooze" ? "Unsnooze" : "Reopen")
              column id="row-menu" popover="auto" role="menu"
                if aimedSwipe == "settle"
                  button press=settleAimed popovertarget="row-menu" popovertargetaction="hide" testId="settle"
                    text "Settle"
                if aimedSwipe == "reopen"
                  button press=settleAimed popovertarget="row-menu" popovertargetaction="hide" testId="reopen"
                    text "Reopen"
                if aimedSwipe == "unsnooze"
                  button press=settleAimed popovertarget="row-menu" popovertargetaction="hide" testId="unsnooze"
                    text "Unsnooze"
                if aimedSnooze
                  button popovertarget="snooze-menu" testId="snooze"
                    text "Snooze"
                if aimedKind == "session"
                  button press=askDelete(aimed) destructive=true popovertarget="row-menu" popovertargetaction="hide" testId="delete"
                    text "Delete"
              column id="snooze-menu" popover="auto" role="menu" aria-label="Snooze until"
                for o in inbox.snoozeOptions key=o.id
                  button press=snoozeAimed(o.until) popovertarget="snooze-menu" popovertargetaction="hide" testId=`snooze-${o.id}`
                    text `${o.label} · ${o.when}`
            else
              list id="pair-form" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                section
                  header
                    text "Pair with Hermes"
                  row
                    input value=link input=editLink placeholder="apollo://pair?host=…" aria-label="Pairing link" autocapitalize="off" autocorrect="off" spellcheck=false flex=1 min-width=0 testId="pair-link"
                  footer
                    text "Paste the apollo://pair link from the connector. It works once and expires after a few minutes."
                section
                  button press=pair disabled=(link.trim() == "" or pending(paired)) testId="pair"
                    text (pending(paired) ? "Pairing…" : "Pair")
                if notice != ""
                  section
                    row
                      text notice color="-exact-system-red" testId="pair-error"
        if e.name == "card"
          column navigationKey=`${e.id}` navigationScroll="card" position="absolute" inset=0 display="flex" flex-direction="column"
            interactive-widget="resizes-content"
            header display="flex" flex-direction="column" padding="8px 16px" gap=2
              text card.source role="heading" aria-level=2
            column id="card" flex=1 min-height=0 overflow-y="auto" padding="8px 20px 24px" gap=14
              text card.title font="-exact-title2" font-weight=700 user-select="text" testId="card-title"
              if card.outcome != ""
                text card.outcome font="-exact-subheadline" color="-exact-secondary-label" testId="card-outcome"
              if card.progress != ""
                column gap=4
                  text card.progress font="-exact-footnote" color="-exact-secondary-label"
                  progress value=card.progressValue aria-label=card.progress
              if card.meta.length > 0
                column gap=4
                  for m in card.meta key=m.key
                    row gap=8
                      text m.key font="-exact-footnote" color="-exact-secondary-label" width=96 flex-shrink=0
                      text m.value markup="markdown" font="-exact-footnote" flex=1 min-width=0 user-select="text"
              if card.metrics.length > 0
                row gap=16 flex-wrap="wrap"
                  for m in card.metrics key=m.label
                    column gap=1
                      text m.value font="-exact-title3" font-weight=600
                      text m.label font="-exact-caption1" color="-exact-secondary-label"
                      if m.delta != ""
                        text m.delta font="-exact-caption1" color=(m.tone == "good" ? "-exact-system-green" : m.tone == "bad" ? "-exact-system-red" : "-exact-secondary-label")
              if card.picks.length > 0
                column gap=2
                  for p in card.picks key=p.n
                    PickRow(pick=p, press=toggle(p), open=openPick(card.id, p), off=(not card.open or pending(responded)), tid=`pick-${p.n}`)
              if card.body != ""
                if card.plainText
                  text card.body user-select="text" overflow-wrap="anywhere"
                else
                  text card.body markup="markdown" user-select="text" overflow-wrap="anywhere" testId="card-body"
            if shownError != ""
              text shownError font="-exact-footnote" color="-exact-system-red" padding="4px 16px" testId="error"
            if replying != ""
              column margin="6px 12px" gap=8
                textarea id="reply" value=reply input=editReply rows=3 field-sizing="content" max-height=200 placeholder="Reply" aria-label="Reply" autofocus=true
                  padding="10px 12px" border-radius=12 border="1px solid -exact-separator" background-color="transparent" testId="reply"
                row gap=8 justify-content="flex-end"
                  button press=cancelReply buttonStyle="bordered" testId="reply-cancel"
                    text "Cancel"
                  button press=sendReply buttonStyle="filled" disabled=(reply.trim() == "" or pending(responded)) testId="reply-send"
                    text "Send"
            else
              row gap=8 padding="8px 16px 12px" flex-wrap="wrap" justify-content="flex-end"
                for a in card.actions key=a.id
                  button press=cardAction(a) buttonStyle=(a.style == "primary" ? "filled" : "bordered") destructive=(a.style == "destructive") disabled=pending(responded) testId=`card-act-${a.id}`
                    text a.label
                if card.threadId != ""
                  link href=path("session", card.threadId) testId="card-thread"
                    text "Open thread"
                if card.url != ""
                  button press=openLink(card.url) buttonStyle="bordered" testId="card-link"
                    text "Open link"
                if card.swipe == "settle"
                  button press=settleOpenCard(true) buttonStyle="bordered" testId="card-settle"
                    text "Settle"
                if card.swipe == "reopen"
                  button press=settleOpenCard(false) buttonStyle="bordered" testId="card-reopen"
                    text "Reopen"
        if e.name == "session" or e.name == "compose"
          column navigationKey=`${e.id}` navigationScroll="transcript" position="absolute" inset=0 display="flex" flex-direction="column"
            interactive-widget="resizes-content"
            header display="flex" align-items="center" gap=8 padding="8px 16px"
              column flex=1 min-width=0 gap=1
                text (e.name == "compose" ? "New Thread" : thread.title == "" ? "Thread" : thread.title) role="heading" aria-level=2 line-clamp=1 testId="title"
                if thread.active and e.name == "session"
                  text (thread.status == "waiting_for_approval" ? "Needs approval" : thread.status == "stopping" ? "Stopping" : "Working") font="-exact-caption1"
                    color=(thread.status == "waiting_for_approval" ? "-exact-system-orange" : "AccentColor") testId="status"
              if e.name == "session"
                button popovertarget="thread-menu" aria-label="Thread actions" testId="thread-more"
                  image "symbol:more"
            column id="thread-menu" popover="auto" role="menu"
              if thread.canSettle
                button press=settleThread(true) popovertarget="thread-menu" popovertargetaction="hide" testId="finish"
                  text "Settle"
              if thread.settled
                button press=settleThread(false) popovertarget="thread-menu" popovertargetaction="hide" testId="reopen-thread"
                  text "Reopen thread"
              button press=toggleAutoSettle role="menuitemcheckbox" aria-checked=thread.autoSettle popovertarget="thread-menu" popovertargetaction="hide" testId="auto-settle"
                text "Auto-settle"
              button press=askDelete(selected) destructive=true popovertarget="thread-menu" popovertargetaction="hide" testId="delete-thread"
                text "Delete"
            if e.name == "compose"
              column flex=1 display="flex" justify-content="center" align-items="center" padding=24 gap=6
                image "symbol:sparkles" width=28 height=28 color="AccentColor"
                text "What should Hermes do?" font="-exact-title3" text-align="center"
            else
              list id="transcript" appearance="none" virtualized=true scroll-start="end" scrollFollowEnd=true flex=1 min-height=0 padding-top=8 padding-bottom=16 testId="transcript"
                for r in thread.rows key=r.id
                  column padding=(r.kind == "live" ? "0 16px 0 30px" : r.kind == "text" or r.kind == "table" ? "4px 16px" : "8px 16px") testId=`row-${r.id}`
                    if r.kind == "user"
                      column align-items="flex-end" padding-left=48 gap=4
                        if r.text != ""
                          text r.text padding="8px 12px" border-radius=18 overflow-wrap="anywhere" user-select="text"
                            background-color="AccentColor" color="AccentColorText"
                        if r.summary != ""
                          row gap=4 align-items="center"
                            image "symbol:sf/paperclip" font-size=11 color="-exact-secondary-label"
                            text r.summary font="-exact-footnote" color="-exact-secondary-label" testId=`files-${r.id}`
                    if r.kind == "text"
                      text r.text markup="markdown" user-select="text" overflow-wrap="anywhere"
                    if r.kind == "live"
                      text r.text markup="markdown" user-select="text" overflow-wrap="anywhere" font="-exact-subheadline" color="-exact-secondary-label"
                        padding-left=10 border-left="2px solid -exact-separator"
                    if r.kind == "table"
                      column border-width=1 border-style="solid" border-color="-exact-separator" border-radius=8 overflow="hidden"
                        for t in r.table key=t.key
                          row border-top-width=(t.head ? 0 : 1) border-right-width=0 border-bottom-width=0 border-left-width=0 border-style="solid" border-color="-exact-separator"
                            background-color=(t.head ? "-exact-secondary-background" : "transparent")
                            for c in t.cells key=c.key
                              text c.text markup="markdown" user-select="text" overflow-wrap="anywhere" flex="1 1 0" min-width=0 font="-exact-subheadline"
                                padding="6px 8px" text-align=c.align border-top-width=0 border-right-width=0 border-bottom-width=0 border-left-width=(c.first ? 0 : 1) border-style="solid" border-color="-exact-separator"
                    if r.kind == "system"
                      text r.text font="-exact-footnote" color="-exact-secondary-label" user-select="text"
                    if r.kind == "error"
                      text r.text font="-exact-footnote" color="-exact-system-red" user-select="text"
                    if r.kind == "activity"
                      column gap=6
                        button appearance="none" press=toggleSteps(r.id) display="flex" flex-direction="row" align-items="center" justify-content="flex-start" text-align="left" gap=8 align-self="stretch" padding="2px 0" testId=`activity-${r.id}`
                          if r.running
                            progress aria-label="Working" width=14 height=14
                          else
                            image (opened.includes(r.id) ? "symbol:sf/chevron.down" : "symbol:forward-chevron") font-size=11 color="-exact-secondary-label"
                          text r.summary text-align="left" font="-exact-footnote" color=(r.running ? (thread.status == "waiting_for_approval" ? "-exact-system-orange" : "-exact-label") : "-exact-secondary-label") line-clamp=1 flex=1 min-width=0
                          if r.running and r.startedAt > 0 and clock > 0
                            text took(clock / 1000 - secs(r.startedAt)) font="-exact-footnote" color="-exact-secondary-label" font-variant-numeric="tabular-nums"
                        if (opened.includes(r.id) or r.running) and r.steps.length > 0
                          column gap=5 padding="2px 0 2px 10px" margin-left=6 border-left="2px solid -exact-separator"
                            for s in r.steps key=s.key
                              column gap=1
                                row gap=6 align-items="baseline"
                                  text (s.running ? "…" : s.failed ? "✕" : s.kind == "tool" ? "✓" : "·") font="-exact-caption1" color=(s.failed ? "-exact-system-red" : "-exact-secondary-label") width=10 flex-shrink=0
                                  text (s.kind == "tool" ? s.label : s.detail) font="-exact-caption1" color=(s.kind == "tool" ? "-exact-label" : "-exact-secondary-label") line-clamp=3 flex=1 min-width=0 user-select="text"
                                if s.kind == "tool" and s.detail != ""
                                  text s.detail font="-exact-caption2" font-family="ui-monospace" color="-exact-secondary-label" line-clamp=2 padding-left=16 user-select="text"
            if thread.approvalCommand != "" and e.name == "session"
              column margin="0 12px" padding=12 gap=8 border-radius=12 background-color="-exact-secondary-background" testId="approval"
                text thread.approvalTitle font="-exact-headline"
                if thread.approvalReason != ""
                  text thread.approvalReason font="-exact-subheadline" color="-exact-secondary-label"
                text thread.approvalCommand font-family="ui-monospace" font="-exact-footnote" user-select="text" line-clamp=8
                row gap=8 justify-content="flex-end"
                  button press=deny buttonStyle="bordered" disabled=pending(answered) testId="deny"
                    text "Deny"
                  button press=approve buttonStyle="filled" disabled=pending(answered) testId="approve"
                    text "Allow once"
            if shownError != ""
              row gap=8 align-items="center" padding="4px 16px"
                text shownError font="-exact-footnote" color="-exact-system-red" flex=1 min-width=0 testId="error"
                button press=refreshAll buttonStyle="bordered" testId="retry"
                  text "Retry"
            if voiceBar
              row margin="6px 12px" min-height=48 padding="4px 6px" gap=6 align-items="center" border-radius=24 background-color="-exact-secondary-background" testId="voice-bar"
                button press=cancelVoice appearance="none" padding=8 aria-label="Cancel dictation" testId="voice-cancel"
                  image "symbol:close" color="-exact-label"
                if hearing
                  audio-waveform track=trackId tint="#9b9ba1" flex=1 min-width=0 height=28 testId="waveform"
                  text voiceClock font="-exact-subheadline" color="-exact-secondary-label" font-variant-numeric="tabular-nums" testId="voice-clock"
                  button press=finishVoice appearance="none" width=36 height=36 border-radius=18 background-color="AccentColor" display="flex" align-items="center" justify-content="center"
                    flex-shrink=0 aria-label="Done" testId="voice-done"
                    image "symbol:checkmark" color="AccentColorText"
                else
                  text "Preparing" flex=1 min-width=0 text-align="center" color="-exact-secondary-label" testId="voice-preparing"
                  progress aria-label="Preparing dictation" width=36 flex-shrink=0
            else
              column margin="6px 12px" border-radius=20 border="1px solid -exact-separator"
                if files.length > 0
                  row gap=6 flex-wrap="wrap" padding="8px 10px 0"
                    for f in files key=f.path
                      button appearance="none" press=unattach(f.path) aria-label=`Remove ${f.name}` display="flex" flex-direction="row" align-items="center" gap=4
                        padding="4px 8px" border-radius=12 background-color="-exact-secondary-background" max-width="100%" testId=`file-${f.name}`
                        text f.name font="-exact-footnote" line-clamp=1 min-width=0
                        image "symbol:close" font-size=11 color="-exact-secondary-label"
                row align-items="flex-end" padding="0 4px 0 12px"
                  textarea id="composer" value=draft input=edit key=composerKey rows=1 field-sizing="content" max-height=160
                    placeholder="Message" aria-label="Message" testId="composer" flex=1 min-width=0 padding="10px 0"
                    border="none" background-color="transparent" autofocus=(e.name == "compose")
                  if thread.active and e.name == "session"
                    button press=stop buttonStyle="bordered" margin="4px 0" aria-label="Stop" testId="stop"
                      image "symbol:stop-fill"
                  else
                    button press=submit disabled=(not canSend) buttonStyle="filled" margin="4px 0" retainFocus=true aria-label="Send" testId="send"
                      image "symbol:send"
                row gap=2 align-items="center" padding="0 6px 4px"
                  button popovertarget="add-menu" appearance="none" padding=8 aria-label="Add" testId="add"
                    image "symbol:add" color="-exact-secondary-label"
                  button popovertarget="model-menu" appearance="none" padding="8px 6px" display="flex" flex-direction="row" gap=3 align-items="center" testId="model"
                    text modelLabel font="-exact-footnote" color="-exact-secondary-label" line-clamp=1
                    image "symbol:chooser" font-size=10 color="-exact-secondary-label"
                  view flex=1
                  // As in Apollo, the mic shows only where this phone can transcribe on its own.
                  if voice.availability != "unavailable"
                    button press=dictate appearance="none" padding=8 aria-label="Dictate" testId="dictate"
                      image "symbol:microphone" color="-exact-secondary-label"
            input type="file" id="attach-photo" accept="image/*" multiple=true display="none" change=picked testId="photo-input"
            input type="file" id="attach-file" multiple=true display="none" change=picked testId="file-input"
            column id="add-menu" popover="auto" role="menu"
              button press=attach("attach-photo") popovertarget="add-menu" popovertargetaction="hide" testId="add-photo"
                text "Photo Library"
              button press=attach("attach-file") popovertarget="add-menu" popovertargetaction="hide" testId="add-file"
                text "Choose Files"
              if options.skills.length > 0
                column role="group" aria-label="Skills"
                  for k in options.skills key=k.name
                    button press=insertSkill(k.name) popovertarget="add-menu" popovertargetaction="hide" testId=`skill-${k.name}`
                      text `$${k.name}`
            column id="model-menu" popover="auto" role="menu" aria-label="Model"
              button press=pickModel("") role="menuitemradio" aria-checked=(currentModel == "") popovertarget="model-menu" popovertargetaction="hide" testId="model-default"
                text "Default model"
              for m in options.models key=m.key
                button press=pickModel(m.key) role="menuitemradio" aria-checked=(currentModel == m.key) popovertarget="model-menu" popovertargetaction="hide" testId=`model-${m.key}`
                  text m.label
        if e.name == "share"
          column navigationKey=`${e.id}` navigationScroll="share" position="absolute" inset=0 display="flex" flex-direction="column"
            header display="flex" align-items="center" padding="8px 16px"
              text "Share to Apollo" role="heading" aria-level=2
            list id="share" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
              section
                if shareText != ""
                  text shareText line-clamp=4 overflow-wrap="anywhere" testId="share-text"
                if shareIncoming.files.length > 0 or shareIncoming.pending > 0
                  text `${shareIncoming.files.length + shareIncoming.pending} ${shareIncoming.files.length + shareIncoming.pending == 1 ? "file" : "files"}` color="-exact-secondary-label" testId="share-files"
              section
                button press=useShare(e, "") disabled=(shareIncoming.pending > 0) testId="share-new"
                  text "New thread"
              if shareThreads.length > 0
                section
                  header
                    text "Add to a thread"
                  for t in shareThreads key=t.id
                    button press=useShare(e, t.id) disabled=(shareIncoming.pending > 0) testId=`share-to-${t.id}`
                      text t.title line-clamp=1
              section
                button press=back destructive=true testId="share-discard"
                  text "Discard"
        if e.name == "settings"
          column navigationKey=`${e.id}` navigationScroll="settings" position="absolute" inset=0 display="flex" flex-direction="column"
            header display="flex" align-items="center" padding="8px 16px"
              text "Settings" role="heading" aria-level=2
            list id="settings" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
              section
                header
                  text "Connection"
                row justify-content="space-between" gap=12
                  text "Agent"
                  text account.label color="-exact-secondary-label" line-clamp=1 testId="settings-agent"
                row justify-content="space-between" gap=12
                  text "Endpoint"
                  text account.endpoint color="-exact-secondary-label" line-clamp=1 overflow-wrap="anywhere"
                if options.platform != ""
                  row justify-content="space-between" gap=12
                    text "Platform"
                    text options.platform color="-exact-secondary-label"
                row justify-content="space-between" gap=12
                  text "Default model"
                  text (options.defaultModel == "" ? "Unknown" : options.defaultModel) color="-exact-secondary-label" line-clamp=1
              if options.toolsets.length > 0
                section
                  header
                    text "Toolsets"
                  for t in options.toolsets key=t.name
                    row justify-content="space-between" gap=12 testId=`toolset-${t.name}`
                      column gap=2 flex=1 min-width=0
                        text t.label
                        text `${t.tools} ${t.tools == 1 ? "tool" : "tools"}` font="-exact-footnote" color="-exact-secondary-label"
                      text (t.enabled ? "On" : "Off") color="-exact-secondary-label"
              section
                button press=askUnpair destructive=true testId="settings-unpair"
                  text "Unpair this phone"
      dialog id="delete-thread" role="alertdialog" aria-label="Delete thread?"
        text "This removes it from Hermes for every device."
        button press=deleteAimed destructive=true commandfor="delete-thread" command="close" testId="delete-confirm"
          text "Delete"
        button commandfor="delete-thread" command="close" testId="delete-cancel"
          text "Cancel"
      dialog id="unpair" role="alertdialog" aria-label="Unpair this phone?"
        text "You'll need a new pairing link to connect again."
        button press=unpair destructive=true commandfor="unpair" command="close" testId="unpair-confirm"
          text "Unpair"
        button commandfor="unpair" command="close" testId="unpair-cancel"
          text "Cancel"

// A checklist pick as Apollo draws one: its number in a ring, filled when done.
component PickRow
  props
    pick: Pick
    press: action
    open: action
    off: bool
    tid: string
  view
    row gap=10 align-items="flex-start" align-self="stretch"
      button appearance="none" press=press disabled=off role="checkbox" aria-checked=pick.done aria-label=pick.text padding="6px 0" flex-shrink=0 testId=tid
        text `${pick.n}` font="-exact-caption1" font-weight=600 width=22 height=22 border-radius=11 text-align="center" line-height="20px" box-sizing="border-box"
          border=(pick.done ? "1px solid AccentColor" : "1.5px solid -exact-secondary-label") background-color=(pick.done ? "AccentColor" : "transparent")
          color=(pick.done ? "AccentColorText" : "-exact-secondary-label")
      button appearance="none" press=open role=(pick.url != "" ? "link" : "button") display="flex" flex-direction="column" flex=1 min-width=0 gap=2
        align-items="flex-start" justify-content="flex-start" text-align="left" padding="6px 0" testId=`${tid}-open`
        text pick.text text-align="left" text-decoration=(pick.done ? "line-through" : "none")
          color=(pick.done ? "-exact-secondary-label" : (pick.url != "" ? "-exact-system-cyan" : "-exact-label"))
        if pick.sub != ""
          text pick.sub font="-exact-footnote" color="-exact-secondary-label" text-align="left"
