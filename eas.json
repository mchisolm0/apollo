{
  "cli": {
    "version": ">= 20.2.0",
    "appVersionSource": "remote",
    "requireCommit": false
  },
  "build": {
    "development:device": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "buildConfiguration": "Debug",
        "simulator": false
      },
      "environment": "development",
      "channel": "apollo-dev",
      "env": {
        "APOLLO_APP_VARIANT": "development"
      }
    },
    "production:internal": {
      "extends": "production",
      "distribution": "internal"
    },
    "preview:device": {
      "extends": "production",
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "env": {
        "APOLLO_APP_VARIANT": "preview"
      },
      "autoIncrement": false,
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "channel": "production",
      "env": {
        "APOLLO_APP_VARIANT": "production"
      },
      "autoIncrement": true,
      "ios": {
        "buildConfiguration": "Release",
        "simulator": false
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
