{
  "name": "apollo",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@apollo/native-composer-editor": "file:modules/apollo-composer-editor",
    "@apollo/native-markdown-text": "file:modules/apollo-markdown-text",
    "@apollo/native-quick-look": "file:modules/apollo-quick-look",
    "@apollo/native-review-diff": "file:modules/apollo-review-diff",
    "@expo/ui": "~58.0.25",
    "@legendapp/list": "3.3.5",
    "@react-native-ai/apple": "0.12.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "effect": "3.22.1",
    "expo": "~58.0.21",
    "expo-application": "~58.1.2",
    "expo-audio": "~58.0.10",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.17",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-quick-actions": "^6.0.2",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.19",
    "expo-web-browser": "~58.0.7",
    "posthog-react-native": "4.67.1",
    "prismjs": "^1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-enriched-markdown": "^1.0.2",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-nitro-markdown": "0.5.8",
    "react-native-nitro-modules": "0.35.9",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "4.30.1",
    "react-native-sse": "^1.2.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/prismjs": "^1.26.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:expo": "expo start --dev-client",
    "build:ios:dev": "mkdir -p build && eas build --profile development:device --platform ios --local --output build/ios-dev.ipa",
    "build:ios:sim": "mkdir -p build && eas build --profile development:simulator --platform ios --local --output build/ios-sim.tar.gz",
    "build:ios:internal": "eas build --profile production:internal --platform ios",
    "build:ios:prod": "mkdir -p build && eas build --profile production --platform ios --local --output build/ios-prod.ipa",
    "upload:ios:dev": "eas-local upload --platform ios --build-path build/ios-dev.ipa --current --profile development:device --non-interactive",
    "upload:ios:sim": "eas-local upload --platform ios --build-path build/ios-sim.tar.gz --current --profile development:simulator --non-interactive",
    "upload:ios:prod": "eas-local upload --platform ios --build-path build/ios-prod.ipa --current --profile production --non-interactive",
    "put:ios:dev": "builds put build/ios-dev.ipa --platform ios --profile development:device",
    "put:ios:sim": "builds put build/ios-sim.tar.gz --platform ios --profile development:simulator",
    "put:ios:prod": "builds put build/ios-prod.ipa --platform ios --profile production",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test:connector": "node --test connector/**/*.test.mjs",
    "test:cloud": "pnpm --filter @apollo/cloud typecheck && pnpm --filter @apollo/cloud test",
    "install:macos-services": "./scripts/install-macos-services.sh",
    "test:mobile": "node --experimental-strip-types --test src/features/relay/*.test.ts modules/apollo-composer-editor/src/*.test.ts src/lib/*.test.ts src/features/notifications/*.test.ts src/features/content/*.test.ts src/features/updates/*.test.ts src/features/cloud/*.test.ts src/features/attachments/*.test.ts src/features/voice-input/*.test.ts src/features/shortcuts/*.test.ts modules/apollo-markdown-text/src/*.test.ts",
    "start:dev": "APOLLO_APP_VARIANT=development expo start --dev-client --port 8085",
    "ios:dev": "APOLLO_APP_VARIANT=development expo run:ios --port 8085",
    "build:ios:preview": "eas build --profile preview:device --platform ios",
    "update:dev": "APOLLO_APP_VARIANT=development eas update --channel apollo-dev --environment development",
    "build:ios:production": "eas build --profile production --platform ios",
    "build:android:preview": "eas build --profile preview:device --platform android",
    "build:android:production": "eas build --profile production --platform android",
    "update:preview": "APOLLO_APP_VARIANT=preview eas update --channel preview --environment preview",
    "update:production": "APOLLO_APP_VARIANT=production eas update --channel production --environment production"
  },
  "private": true,
  "enriched-markdown": {
    "enableMath": false,
    "enableCodeHighlight": true,
    "codeHighlightLanguages": [
      "typescript",
      "javascript",
      "json",
      "bash",
      "python",
      "css",
      "html"
    ]
  },
  "expo": {
    "autolinking": {
      "buildFromSource": [
        "react-native-screens"
      ]
    }
  }
}
