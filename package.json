{
  "name": "ekho",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.15",
    "@legendapp/list": "3.3.5",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.19",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.4",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.18",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.21",
    "expo-web-browser": "~57.0.2",
    "prismjs": "^1.30.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-enriched-markdown": "^1.0.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-sse": "^1.2.1",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "expo-notifications": "~57.0.17",
    "effect": "3.22.1",
    "expo-crypto": "~57.0.2",
    "expo-sharing": "~57.0.18",
    "expo-paste-input": "0.1.15",
    "@ekho/native-markdown-text": "file:modules/ekho-markdown-text",
    "@ekho/native-review-diff": "file:modules/ekho-review-diff",
    "expo-clipboard": "~57.0.1",
    "react-native-nitro-markdown": "0.5.8",
    "react-native-nitro-modules": "0.35.9",
    "posthog-react-native": "4.67.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/prismjs": "^1.26.6",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:expo": "expo start --dev-client",
    "build:ios:dev": "eas build --profile development:device --platform ios --local",
    "build:ios:internal": "eas build --profile production:internal --platform ios",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test:connector": "node --test connector/**/*.test.mjs",
    "install:macos-services": "./scripts/install-macos-services.sh",
    "test:mobile": "node --experimental-strip-types --test src/features/relay/*.test.ts src/lib/*.test.ts src/features/notifications/*.test.ts src/features/content/*.test.ts",
    "start:dev": "EKHO_APP_VARIANT=development expo start --dev-client --port 8085",
    "ios:dev": "EKHO_APP_VARIANT=development expo run:ios --port 8085",
    "build:ios:preview": "eas build --profile preview:device --platform ios",
    "update:dev": "EKHO_APP_VARIANT=development eas update --channel ekho-dev --environment development",
    "build:ios:production": "eas build --profile production --platform ios",
    "build:android:preview": "eas build --profile preview:device --platform android",
    "build:android:production": "eas build --profile production --platform android",
    "update:preview": "EKHO_APP_VARIANT=preview eas update --channel preview --environment preview",
    "update:production": "EKHO_APP_VARIANT=production eas update --channel production --environment production"
  },
  "private": true,
  "enriched-markdown": {
    "enableMath": false,
    "enableCodeHighlight": true,
    "codeHighlightLanguages": [
      "typescript",
      "javascript",
      "json",
      "bash",
      "python",
      "css",
      "html"
    ]
  },
  "expo": {
    "autolinking": {
      "buildFromSource": [
        "react-native-screens"
      ]
    }
  }
}
